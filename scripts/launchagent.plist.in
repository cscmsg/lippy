<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.cscmsg.localflow.flowd</string>
	<key>ProgramArguments</key>
	<array>
		<string>@PYTHON@</string>
		<string>@REPO@/daemon/flowd.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Application Support/LocalFlow/flowd.out.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Application Support/LocalFlow/flowd.err.log</string>
</dict>
</plist>
